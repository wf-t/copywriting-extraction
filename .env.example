# Copy to .env and load it with: set -a; source .env; set +a
# This file contains placeholders only. Never commit your .env.
CDK_ADMIN_USERNAME=admin
CDK_ADMIN_PASSWORD=replace-with-a-long-random-password

# Required for semantic organization, with either ASR engine.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Required only for Fun-ASR; choose the engine in the admin panel.
DASHSCOPE_API_KEY=

COPY_STUDIO_HOST=127.0.0.1
COPY_STUDIO_PORT=8765
# Optional absolute directory containing data/ and frontend/dist/.
# COPY_STUDIO_ROOT=/absolute/path/to/copy-studio
COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=127.0.0.1
TRANSCRIPT_LOCAL_WORKERS=1
TRANSCRIPT_FUN_ASR_WORKERS=5
# Optional Whisper executable path, otherwise .venv/bin/whisper or PATH.
# WHISPER_COMMAND=/absolute/path/to/whisper
